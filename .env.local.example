# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google OAuth (for Calendar, Gmail, Drive sync)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth state encryption secret (generate with: openssl rand -hex 32)
OAUTH_STATE_SECRET=your_state_secret

# Resend (transactional email)
RESEND_API_KEY=re_xxxxx
NOTIFICATION_EMAIL_FROM=Wah We Doin <notifications@yourdomain.com>

# Cron job security (generate a random string)
CRON_SECRET=your_cron_secret
